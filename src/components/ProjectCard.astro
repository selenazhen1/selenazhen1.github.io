---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ProjectStatus } from '../lib/types';
import StatusBadge from './ui/StatusBadge.astro';

/**
 * A project card styled as a drawing sheet: figure viewport on top (or left, when wide),
 * and a title block underneath listing role, tools, and status.
 */
interface Props {
  href: string;
  title: string;
  summary: string;
  organization: string;
  dates: string;
  role: string;
  tools: string[];
  status: ProjectStatus;
  cover: ImageMetadata;
  coverAlt: string;
  /** Figure number shown in the image corner, e.g. "01". */
  figure: string;
  layout?: 'standard' | 'wide';
}

const {
  href,
  title,
  summary,
  organization,
  dates,
  role,
  tools,
  status,
  cover,
  coverAlt,
  figure,
  layout = 'standard',
} = Astro.props;

const sizes =
  layout === 'wide'
    ? '(min-width: 64rem) 44rem, (min-width: 48rem) 55vw, 100vw'
    : '(min-width: 64rem) 36rem, (min-width: 48rem) 50vw, 100vw';
---

<article class:list={['card', `card--${layout}`]}>
  <div class="media">
    <Image src={cover} alt={coverAlt} widths={[480, 800, 1200, 1600]} sizes={sizes} />
    <span class="label figure">Fig. {figure}</span>
  </div>

  <div class="body">
    <p class="label meta">
      <span>{organization}</span>
      <span aria-hidden="true">/</span>
      <span>{dates}</span>
    </p>
    <h3>
      <a href={href}>{title}</a>
    </h3>
    <p class="summary">{summary}</p>

    <dl class="title-block">
      <div>
        <dt class="label">Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt class="label">Tools</dt>
        <dd>{tools.join(' · ')}</dd>
      </div>
      <div>
        <dt class="label">Status</dt>
        <dd>
          <StatusBadge status={status} />
        </dd>
      </div>
    </dl>
  </div>

  <span class="corner corner--tl" aria-hidden="true"></span>
  <span class="corner corner--br" aria-hidden="true"></span>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--c-line);
    background: oklch(0.2 0.052 260 / 0.75);
    transition: border-color var(--dur-base) var(--ease-out-quart);
  }

  .card:hover {
    border-color: var(--c-line-strong);
  }

  /* The whole card is one link target (stretched from the title link). */
  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card:hover h3 a {
    color: var(--c-accent);
  }

  .card:has(h3 a:focus-visible) {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }

  h3 a:focus-visible {
    outline: none;
  }

  /* ── Figure viewport ─────────────────────────────── */
  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--c-line);
    background: var(--c-deep);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .card:hover .media img {
    transform: scale(1.035);
  }

  .figure {
    position: absolute;
    left: var(--space-xs);
    bottom: var(--space-xs);
    padding: 0.25em 0.6em;
    background: oklch(0.155 0.045 262 / 0.82);
    color: var(--c-text-muted);
  }

  /* ── Body & title block ──────────────────────────── */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-m) var(--space-m) 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  h3 {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .summary {
    color: var(--c-text-muted);
    max-width: var(--prose-max);
  }

  .title-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto;
    margin: auto calc(-1 * var(--space-m)) 0;
    margin-top: var(--space-m);
    border-top: 1px solid var(--c-line);
  }

  .title-block > div {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    padding: var(--space-xs) var(--space-m);
  }

  .title-block > div + div {
    border-left: 1px solid var(--c-line);
  }

  dd {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--c-text);
  }

  @media (max-width: 34rem) {
    .title-block {
      grid-template-columns: 1fr 1fr;
    }

    .title-block > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
      border-left: 0;
      border-top: 1px solid var(--c-line);
    }
  }

  /* ── Wide layout: figure left, sheet right ───────── */
  @media (min-width: 48rem) {
    .card--wide {
      grid-template-rows: none;
      grid-template-columns: 1.15fr 1fr;
    }

    .card--wide .media {
      aspect-ratio: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--c-line);
    }

    .card--wide .title-block {
      grid-template-columns: 1fr 1fr;
    }

    .card--wide .title-block > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
      border-left: 0;
      border-top: 1px solid var(--c-line);
    }
  }

  /* ── Registration marks: drift outward on hover ──── */
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--c-accent);
    border-style: solid;
    opacity: 0.7;
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      opacity var(--dur-base) var(--ease-out-quart);
    pointer-events: none;
  }

  .corner--tl {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .corner--br {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  .card:hover .corner {
    opacity: 1;
  }

  .card:hover .corner--tl {
    transform: translate(-5px, -5px);
  }

  .card:hover .corner--br {
    transform: translate(5px, 5px);
  }
</style>
