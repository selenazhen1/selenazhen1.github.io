---
import headshot from '../../assets/images/headshot.jpg';
import { SITE } from '../../data/site';
import Portrait from '../Portrait.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="container section" aria-labelledby="about">
  <SectionHeading index="01" title="About" id="about" />
  <div class="about">
    <Portrait src={headshot} alt={`Portrait of ${SITE.name}`} caption="S. Zhen · UCLA" />
    <div class="copy">
      <p class="lead">
        I'm a mechanical engineering student at UCLA, drawn to aerodynamics and to the moment a
        simulation result turns into a physical part.
      </p>
      <p>
        On Bruin Formula Racing I'm the responsible engineer for the rear wing — designing concepts
        in SolidWorks, testing them in STAR‑CCM+, and laying up the carbon-fiber parts that end up
        on the car. I'm also designing the weapon and chassis for a 3 lb combat robot with UCLA
        ASME.
      </p>
      <p>I like problems where the numbers and the hands-on work have to agree with each other.</p>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-2xl);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .about {
      grid-template-columns: 1fr;
    }

    .about :global(.portrait) {
      max-width: 20rem;
    }
  }

  .copy {
    display: grid;
    gap: var(--space-s);
    max-width: var(--prose-max);
    color: var(--c-text-muted);
  }

  .lead {
    font-size: var(--step-2);
    font-weight: 500;
    font-stretch: var(--stretch-heading);
    line-height: 1.3;
    color: var(--c-text);
  }
</style>
