---
import { TIMELINE } from '../../data/resume';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="container section" aria-labelledby="experience">
  <SectionHeading index="03" title="Experience" id="experience" />
  <ol class="timeline" role="list">
    {TIMELINE.map((entry) => (
      <li class:list={['entry', `entry--${entry.kind}`]}>
        <span class="node" aria-hidden="true" />
        <p class="label dates">{entry.dates}</p>
        <div class="what">
          <h3>{entry.organization}</h3>
          <p class="role">{entry.role}</p>
        </div>
        <p class="summary">{entry.summary}</p>
        <p class="label where">{entry.location}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .section {
    padding-block: var(--space-2xl);
  }

  .timeline {
    position: relative;
    margin: 0;
    border-top: 1px solid var(--c-line);
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1.2fr) auto;
    gap: var(--space-2xs) var(--space-l);
    align-items: baseline;
    padding: var(--space-m) 0 var(--space-m) var(--space-m);
    border-bottom: 1px solid var(--c-line);
    transition: background-color var(--dur-base) var(--ease-out-quart);
  }

  .entry:hover {
    background: oklch(0.2 0.052 260 / 0.5);
  }

  /* Vertical datum line with a node per entry. */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--c-line-strong);
  }

  .node {
    position: absolute;
    top: calc(var(--space-m) + 0.45em);
    left: -4px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--c-accent);
    background: var(--c-bg);
    transform: rotate(45deg);
    transition: background-color var(--dur-base) var(--ease-out-quart);
  }

  .entry:hover .node {
    background: var(--c-accent);
  }

  .entry--education .node {
    border-radius: 50%;
    transform: none;
  }

  .dates {
    color: var(--c-accent);
  }

  h3 {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .role {
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .summary {
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .where {
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 64rem) {
    .entry {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .summary {
      grid-column: 2;
    }

    .where {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .entry {
      grid-template-columns: 1fr;
    }

    .summary {
      grid-column: auto;
    }
  }
</style>
