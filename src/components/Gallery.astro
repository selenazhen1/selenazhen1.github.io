---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { figureNumber } from '../lib/projects';

/**
 * Captioned figure grid. Each image links to a large version, so it works without JavaScript;
 * with JavaScript, clicks open an in-page viewer (<dialog>) with keyboard navigation.
 */
interface Props {
  items: { src: ImageMetadata; alt: string; caption?: string; wide?: boolean }[];
  /** Figure number of the first item (the cover is usually Fig. 01). */
  firstFigure?: number;
}

const { items, firstFigure = 1 } = Astro.props;

const figures = await Promise.all(
  items.map(async (item, index) => ({
    ...item,
    figure: figureNumber(firstFigure + index),
    large: await getImage({ src: item.src, width: Math.min(item.src.width, 2400) }),
  })),
);
---

<div class="gallery" data-gallery>
  {figures.map((item) => (
    <figure class:list={['item', { 'item--wide': item.wide }]}>
      <a
        href={item.large.src}
        data-gallery-link
        data-caption={`Fig. ${item.figure}${item.caption ? ` — ${item.caption}` : ''}`}
      >
        <Image
          src={item.src}
          alt={item.alt}
          widths={[480, 800, 1200, 1600]}
          sizes={item.wide ? '(min-width: 78rem) 74rem, 92vw' : '(min-width: 48rem) 45vw, 92vw'}
          loading="lazy"
        />
        <span class="zoom" aria-hidden="true">
          <svg viewBox="0 0 16 16">
            <path d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4" />
          </svg>
        </span>
      </a>
      <figcaption>
        <span class="label">Fig. {item.figure}</span>
        {item.caption && <span class="caption">{item.caption}</span>}
      </figcaption>
    </figure>
  ))}
</div>

<dialog class="viewer" data-viewer aria-label="Image viewer">
  <figure class="viewer-figure">
    <img class="viewer-image" alt="" />
    <figcaption class="viewer-caption label"></figcaption>
  </figure>
  <div class="viewer-controls">
    <button type="button" class="viewer-button" data-viewer-prev aria-label="Previous image">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M13 8H3M7 4 3 8l4 4"></path>
      </svg>
    </button>
    <span class="viewer-count label" aria-live="polite"></span>
    <button type="button" class="viewer-button" data-viewer-next aria-label="Next image">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4"></path>
      </svg>
    </button>
    <button type="button" class="viewer-button viewer-close" data-viewer-close aria-label="Close">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 3l10 10M13 3 3 13"></path>
      </svg>
    </button>
  </div>
</dialog>

<script>
  import { onPage } from '../scripts/lifecycle';

  onPage(() => {
    const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery-link]'));
    if (!viewer || links.length === 0) return;

    const image = viewer.querySelector<HTMLImageElement>('.viewer-image')!;
    const caption = viewer.querySelector<HTMLElement>('.viewer-caption')!;
    const count = viewer.querySelector<HTMLElement>('.viewer-count')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current]!;
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      count.textContent = `${current + 1} / ${links.length}`;
    };

    const onLinkClick = (event: MouseEvent) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return; // allow open-in-new-tab
      event.preventDefault();
      show(links.indexOf(event.currentTarget as HTMLAnchorElement));
      viewer.showModal();
    };

    const onKey = (event: KeyboardEvent) => {
      if (!viewer.open) return;
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'ArrowLeft') show(current - 1);
    };

    // Clicking the backdrop (the dialog element itself, outside its content) closes it.
    const onViewerClick = (event: MouseEvent) => {
      const target = event.target as Element;
      if (target === viewer || target.closest('[data-viewer-close]')) viewer.close();
      else if (target.closest('[data-viewer-prev]')) show(current - 1);
      else if (target.closest('[data-viewer-next]')) show(current + 1);
    };

    links.forEach((link) => link.addEventListener('click', onLinkClick));
    viewer.addEventListener('click', onViewerClick);
    document.addEventListener('keydown', onKey);

    return () => {
      links.forEach((link) => link.removeEventListener('click', onLinkClick));
      viewer.removeEventListener('click', onViewerClick);
      document.removeEventListener('keydown', onKey);
      if (viewer.open) viewer.close();
    };
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-l) var(--space-m);
  }

  @media (max-width: 40rem) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .item--wide {
    grid-column: 1 / -1;
  }

  .item a {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--c-line);
    background: var(--c-deep);
    cursor: zoom-in;
    transition: border-color var(--dur-base) var(--ease-out-quart);
  }

  .item a:hover {
    border-color: var(--c-line-strong);
  }

  .item img {
    width: 100%;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .item a:hover img {
    transform: scale(1.02);
  }

  .zoom {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: oklch(0.155 0.045 262 / 0.82);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out-quart);
  }

  .item a:hover .zoom,
  .item a:focus-visible .zoom {
    opacity: 1;
  }

  .zoom svg,
  .viewer-button svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--c-accent);
    stroke-width: 1.5;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .label {
    color: var(--c-accent);
  }

  .caption {
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  /* ── Viewer ──────────────────────────────────────── */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100svh;
    max-height: none;
    margin: 0;
    padding: var(--space-m) var(--gutter);
    border: 0;
    background: oklch(0.13 0.04 262 / 0.96);
    color: var(--c-text);
  }

  .viewer::backdrop {
    background: transparent;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-s);
    animation: viewer-in var(--dur-base) var(--ease-out-quart);
  }

  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }

  .viewer-figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-xs);
    min-height: 0;
    pointer-events: none;
  }

  .viewer-image {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    pointer-events: auto;
  }

  .viewer-caption {
    justify-content: center;
    text-align: center;
    color: var(--c-text-muted);
  }

  .viewer-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
  }

  .viewer-button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-s);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out-quart);
  }

  .viewer-button:hover {
    border-color: var(--c-accent);
  }

  .viewer-count {
    min-width: 4rem;
    text-align: center;
  }

  .viewer-close {
    margin-left: var(--space-m);
  }
</style>
