---
import { cardLayout, figureNumber, type Project } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

/** Two-column card list: wide lead card, pairs after it, and no half-empty final row. */
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="grid">
  {projects.map((project, index) => (
    <ProjectCard
      project={project}
      figure={figureNumber(index + 1)}
      layout={cardLayout(index, projects.length)}
    />
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
  }

  .grid > :global(.card--wide) {
    grid-column: 1 / -1;
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
