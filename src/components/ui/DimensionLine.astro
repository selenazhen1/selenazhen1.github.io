---
/**
 * An engineering-drawing dimension line (|←—— label ——→|) that stretches to fill its row.
 * Purely decorative unless a label is given.
 */
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<span class="dimension" aria-hidden={label ? undefined : 'true'}>
  <svg class="end" viewBox="0 0 10 12" aria-hidden="true">
    <path d="M1 0v12M1 6l8-3.5M1 6l8 3.5"></path>
  </svg>
  <span class="rule"></span>
  {label && <span class="label dimension-label">{label}</span>}
  {label && <span class="rule"></span>}
  <svg class="end end--right" viewBox="0 0 10 12" aria-hidden="true">
    <path d="M1 0v12M1 6l8-3.5M1 6l8 3.5"></path>
  </svg>
</span>

<style>
  .dimension {
    display: flex;
    align-items: center;
    min-width: 2rem;
    color: var(--c-line-strong);
  }

  .end {
    flex: none;
    width: 10px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .end--right {
    transform: scaleX(-1);
  }

  .rule {
    flex: 1;
    height: 1px;
    margin-inline: -9px;
    background: currentColor;
  }

  .dimension-label {
    flex: none;
    padding-inline: 1.1rem;
  }
</style>
