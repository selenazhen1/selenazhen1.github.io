---
/** A tool / skill chip. */
---

<span class="tag">
  <slot />
</span>

<style>
  .tag {
    display: inline-block;
    padding: 0.3em 0.65em;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--c-text-muted);
    white-space: nowrap;
  }
</style>
